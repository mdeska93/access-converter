APP_NAME="Access Data Exporter"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

CACHE_STORE=file
SESSION_DRIVER=file

ACCESS_DATABASE_PATH=C:\\Data\\database.accdb
ACCESS_TABLE_ALLOWLIST=
EXPORT_CHUNK_SIZE=10000
EXPORT_MAX_ROWS=0
EXPORT_MAX_FILE_SIZE_MB=10
EXPORT_CSV_MAX_ROWS_PER_FILE=1000000
