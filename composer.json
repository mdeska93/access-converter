{
  "name": "local/access-exporter",
  "type": "project",
  "description": "Laravel local Microsoft Access data browser and Excel/SQL exporter",
  "require": {
    "php": "^8.2|^8.3|^8.4",
    "laravel/framework": "^11.0",
    "phpoffice/phpspreadsheet": "^2.2"
  },
  "require-dev": {
    "laravel/pint": "^1.13"
  },
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/"}},
  "scripts": {"post-autoload-dump": ["@php artisan package:discover --ansi"]},
  "config": {
    "policy": {
      "advisories": {
        "block": false
      }
    }
  }
}
